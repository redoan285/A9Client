# Backend API used by server-rendered and client-side appointment requests
NEXT_PUBLIC_SERVER_URL=https://your-backend.example.com

# Better Auth API base URL, including the /api/auth path
BETTER_AUTH_URL=https://your-vercel-domain.vercel.app/api/auth
NEXT_PUBLIC_AUTH_URL=https://your-vercel-domain.vercel.app/api/auth

# Required by Better Auth and MongoDB adapter
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Optional: Google OAuth. Leave both unset if Google sign-in is not used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
